# Copy this file to ".env" and fill in your actual credentials.
# NEVER commit .env to git — it contains sensitive data.
# Make sure .env is added to .gitignore.

# Razorpay API Keys
# Get from: Razorpay Dashboard -> Account & Settings -> API Keys
# For development: use TEST keys (begin with rzp_test_)
# For production: use LIVE keys (begin with rzp_live_)
RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET

# Server port
PORT=3000

# Razorpay Webhook Secret
# Get from: Razorpay Dashboard -> Account & Settings -> Webhooks -> Add New Webhook
# Webhook URL: https://YOUR-DOMAIN/api/razorpay-webhook
# Events: payment.captured, order.paid, refund.created, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Email Configuration (SMTP)
# Supported services: Gmail (app password), Brevo, Zoho, SendGrid, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Needverse <your-email@gmail.com>"

# Owner email (receives copy of every paid order)
OWNER_EMAIL=your-email@example.com

# Admin panel credentials
# Access orders page at /admin (browser login prompt)
# IMPORTANT: ADMIN_PASSWORD must be a bcrypt hash, not plaintext!
# Generate a hash using: node generate-password-hash.js
# Then paste the hash below (it will look like: $2b$12$.....)
ADMIN_USER=admin
ADMIN_PASSWORD=$2b$12$GENERATED_HASH_GOES_HERE

# Supabase Database Configuration
# Get from: Supabase Dashboard -> Project Settings -> API
# Use the Project URL (not the Postgres URL)
# Use the "service_role" key (NOT the anon key) — it has full database access
# Keep this key on the server only, never commit it or expose it in public code
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
